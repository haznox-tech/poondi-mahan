# Environment variables example
# Copy to .env and fill in values as needed
# Never commit .env to version control

# VITE variables are public — do NOT put secrets here
# VITE_ANALYTICS_ID=G-XXXXXXXXXX

# Production
# VITE_SITE_URL=https://poondimahan.org

# ── Server (server/index.js) ─────────────────────────────────────────────────
# Port the Node backend listens on. cPanel's "Setup Node.js App" sets this for
# you automatically; only needed manually for a PM2/reverse-proxy deployment.
# PORT=3001

# Public display-only hint shown on the login form. NOT used for authentication —
# it only seeds the admin email the FIRST time the server ever starts, when
# server/data/admin-credentials.json doesn't exist yet. Real admin login is
# verified entirely server-side. To set/change the real admin email+password,
# run: node scripts/set-admin-password.js "you@example.com" "a-strong-password"
# VITE_ADMIN_EMAIL=admin@example.com

# ── Gmail SMTP for OTP Email Delivery (Admin Password Reset) ────────────────
# Used by server/mailer.js to send 6-digit OTP emails.
# Without these, the OTP is still logged to the server console but not emailed.
#
# SMTP_USER=your_gmail@gmail.com      # Gmail account used to SEND emails
# SMTP_PASS=xxxx xxxx xxxx xxxx       # Gmail App Password (not regular password)
#                                       # Generate: myaccount.google.com/apppasswords
# SMTP_FROM=your_gmail@gmail.com      # From address shown in email header

# ── GitHub Repository Direct Commit (Optional, opt-in, client-side feature) ─
# Only needed if you use the "Sync to GitHub" button in the Admin Gallery UI.
# VITE_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Cloudinary Media Storage (Global CDN for Photos) ────────────────────────
# Public upload config (safe to expose to the browser):
# VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
# VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
# VITE_CLOUDINARY_API_KEY=your_api_key
#
# Server-only secret used for asset deletion — read by server/galleryRoutes.js,
# NEVER exposed to the browser. Do not prefix this one with VITE_.
# CLOUDINARY_API_SECRET=your_api_secret
