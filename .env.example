# Environment variables example
# Copy to .env and fill in values as needed
# Never commit .env to version control

# VITE variables are public — do NOT put secrets here
# VITE_ANALYTICS_ID=G-XXXXXXXXXX

# Production
# VITE_SITE_URL=https://poondimahan.org

# ── Gmail SMTP for OTP Email Delivery (Admin Password Reset) ────────────────
# Used by vite.config.js server middleware (dev mode) to send 6-digit OTP emails.
# Without these, OTP is still printed to the terminal but not emailed.
#
# SMTP_USER=your_gmail@gmail.com      # Gmail account used to SEND emails
# SMTP_PASS=xxxx xxxx xxxx xxxx       # Gmail App Password (not regular password)
#                                       # Generate: myaccount.google.com/apppasswords
# SMTP_FROM=your_gmail@gmail.com      # From address shown in email header
# SMTP_TO=admin@example.com           # Where the OTP email is delivered to

# ── GitHub Repository Direct Commit (Optional env fallback) ─────────────────
# Can be entered directly in the Admin Gallery UI or defined here:
# VITE_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Cloudinary Media Storage (Global CDN for Photos) ────────────────────────
# Can be entered directly in Admin Gallery UI or defined here:
# VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
# VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
# VITE_CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret  # Secret used for asset deletion (never commit)
